    {
      "parameters": {
        "jsCode": "const fecha = $input.first().json.currentDate\n\nlet webhookData = {}\nlet formData = {}\n\ntry {\n  webhookData = $('Webhook').first().json.body || {}\n} catch (e) {}\n\ntry {\n  formData = $('On form submission').first().json || {}\n} catch (e) {}\n\nconst isWebhook = Object.keys(webhookData).length > 0\nconst isForm = Object.keys(formData).length > 0\n\nconst submitionType = isWebhook\n  ? \"Webhook\"\n  : isForm\n    ? \"Formulario\"\n    : \"Desconocido\"\n\nconst nombre =\n  webhookData.nombre ||\n  formData.Nombre ||\n  \"\"\n\nconst email =\n  webhookData.email ||\n  formData.Email ||\n  \"\"\n\nconst calificacion =\n  webhookData.calificacion ||\n  formData.Calificacion ||\n  1\n\nconst feedback =\n  webhookData.feedback ||\n  formData.Feedback ||\n  \"\"\n\nreturn [\n  {\n    json: {\n      fecha,\n      submitionType,\n      nombre,\n      email,\n      calificacion,\n      feedback,\n    }\n  }\n]"
      },
