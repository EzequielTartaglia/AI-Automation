    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\n// Remover ```json y ```\nconst clean = raw\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(clean);\n} catch (error) {\n  return [\n    {\n      json: {\n        status: \"error\",\n        parsing_error: true,\n        raw_response: raw,\n        message: error.message,\n      },\n    },\n  ];\n}\n\n// Retornar estructura manipulable\nreturn [\n  {\n    json: {\n      status: parsed.status || null,\n      total: parsed.total || 0,\n      respuesta_cliente: parsed.respuesta_cliente || null,\n      productos: parsed.productos || [],\n      error_email: parsed.error_email || null,\n\n      // Datos extra útiles\n      cantidad_productos: parsed.productos?.length || 0,\n\n      // JSON completo\n      full_response: parsed,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
