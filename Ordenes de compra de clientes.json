    {
      "parameters": {
        "jsCode": "const items = $input.first().json[0]?.catalog || $input.first().json.catalog || [];\n\nconst productos = items.map((item) => {\n  return `\nCódigo: ${item.codigo}\nNombre: ${item.nombre}\nCategoría: ${item.categoria}\nUnidad de medida: ${item[\"unidad de medida\"]}\nStock: ${item[\"cantidad en stock\"]}\nPrecio: ${item[\"precio\"]}\n`;\n});\n\nreturn [\n  {\n    json: {\n      contexto_productos: productos.join(\"\\n-------------------\\n\"),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -128
      ],
      "id": "58bc0fb7-3929-4b9d-bf59-3d47c4717fbe",
